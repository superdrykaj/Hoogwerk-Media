# ============================================================================
#  Omgevingsvariabelen — kopieer dit bestand naar .env.local en vul het in.
#  Deze waarden staan ALLEEN op de server en komen nooit in de frontend.
#  Zet .env.local nooit in je repository.
# ============================================================================

# --- Beheeromgeving (verplicht) ---------------------------------------------
# Maak beide waarden met:  npm run hash-password -- 'jouw-lange-wachtwoord'
ADMIN_PASSWORD_HASH=""
AUTH_SECRET=""

# --- Staat van de site -------------------------------------------------------
# Zolang dit niet op "live" staat, ziet een bezoeker alleen de pagina
# "binnenkort online" en vragen we zoekmachines om weg te blijven. Ben je
# ingelogd via /admin, dan zie je de volledige site gewoon.
# Zet op "live" als het portfolio met eigen werk gevuld is.
SITE_STATUS="soon"

# --- Website ----------------------------------------------------------------
# Publieke adres van de site. Gebruikt voor metadata, sitemap en deelbeelden.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # in productie: https://hoogbeeldmedia.nl

# --- Opslag (optioneel) ------------------------------------------------------
# Standaard staan de database en de uploads in de map ./data
# DATA_DIR="/var/lib/hoogbeeld-media"
# DATABASE_PATH="/var/lib/hoogbeeld-media/kai-aerials.db"

# --- E-mail (optioneel, maar nodig voor bevestigingsmails) -------------------
# Zolang deze waarden leeg zijn, wordt er GEEN e-mail verstuurd. Aanvragen en
# berichten worden wel gewoon opgeslagen en de site zegt er eerlijk bij dat er
# geen mail is verzonden.
#
# Bij Microsoft 365: SMTP_HOST="smtp.office365.com" en poort 587. Zet eerst
# "Geverifieerde SMTP" aan voor het postvak, anders wordt inloggen geweigerd.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Afzender. Dit moet een adres zijn dat het postvak mag gebruiken. Bij
# Microsoft 365 is dat standaard alleen het hoofdadres, niet een alias.
MAIL_FROM="Hoogbeeld Media <kai@hoogbeeldmedia.nl>"

# Waar de meldingen naartoe gaan. Laat je deze leeg, dan gebruikt de site de
# adressen uit content/site.ts: boekingen@ voor aanvragen en info@ voor
# contactberichten. MAIL_TO stuurt allebei naar hetzelfde adres.
# MAIL_TO_BOOKINGS="boekingen@hoogbeeldmedia.nl"
# MAIL_TO_CONTACT="info@hoogbeeldmedia.nl"
# MAIL_TO=""

# Waar de agenda-uitnodiging (.ics) heen gaat zodra je een afspraak bevestigt.
# Standaard het persoonlijke adres uit content/site.ts, want daar hangt de
# agenda aan. MAIL_TO trekt deze bewust niet mee: een verzamelpostvak is geen
# agenda.
# MAIL_TO_CALENDAR="kai@hoogbeeldmedia.nl"
